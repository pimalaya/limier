<!-- Single top and left lines, closing the frame the cells leave open. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:left="-1dp" android:right="-1dp" android:bottom="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/table_border" />
        </shape>
    </item>

    <item android:top="-1dp" android:right="-1dp" android:bottom="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/table_border" />
        </shape>
    </item>

</layer-list>
