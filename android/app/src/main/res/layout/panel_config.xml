<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/FrameTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/config_title" />

            <EditText
                android:id="@+id/config_domain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/config_domain_hint"
                android:inputType="textUri" />

            <EditText
                android:id="@+id/config_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/config_port_hint"
                android:inputType="number"
                android:text="993" />

            <Spinner
                android:id="@+id/config_sasl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:entries="@array/sasl_mechanisms" />

            <EditText
                android:id="@+id/config_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/config_login_hint"
                android:inputType="textEmailAddress" />

            <EditText
                android:id="@+id/config_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/config_password_hint"
                android:inputType="textPassword" />

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/config_submit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/config_submit" />

</LinearLayout>
