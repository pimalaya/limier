<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_bar"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/top_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_action"
            android:src="@drawable/ic_arrow_back"
            android:visibility="gone" />

        <TextView
            android:id="@+id/top_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:text="@string/app_name"
            android:textColor="@color/app_bar_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/top_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_action"
            android:src="@drawable/ic_settings" />

        <ImageButton
            android:id="@+id/top_about"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/about_action"
            android:src="@drawable/ic_info"
            android:visibility="gone" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ViewFlipper
            android:id="@+id/flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <include layout="@layout/panel_config" />

            <include layout="@layout/panel_main" />

            <include layout="@layout/panel_detail" />

            <include layout="@layout/panel_about" />

        </ViewFlipper>

        <!-- Thin loading bar overlaid on the top edge of the content, flush
             against the app bar and shown only while a search runs. Drawn as
             an overlay (not a flow sibling) so toggling it never shifts the
             content down: done portion in the app bar blue (left), remaining
             in white. -->
        <ProgressBar
            android:id="@+id/search_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:elevation="4dp"
            android:max="100"
            android:minHeight="3dp"
            android:maxHeight="3dp"
            android:progress="0"
            android:indeterminateTint="@color/app_bar"
            android:progressBackgroundTint="@android:color/white"
            android:progressTint="@color/app_bar"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
